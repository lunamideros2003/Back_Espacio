PORT=8000
# Local development uses SQLite. Production uses Supabase Postgres.
DATABASE_URL=sqlite:///./astroia.db
# Supabase -> Settings -> Database -> Connection string -> Connection pooling.
# URL-encode special characters in the password. Keep the real value in Render,
# never in this file.
# DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
AUTO_CREATE_TABLES=1
JWT_SECRET=cambia-esta-clave
NASA_API_KEY=DEMO_KEY

# --- IA del chatbot ---
# Proveedor: auto | groq | gemini | local
#   auto  -> usa Groq si hay clave, si no Gemini, si no respuesta local
#   gemini -> fuerza Google AI Studio
AI_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Origenes EXTRA separados por coma. Se SUMAN a los que ya vienen en el codigo
# (localhost:5173 y https://fron-espacio.vercel.app), asi que NO es obligatorio.
CORS_ORIGINS=
