PORT=8000
DATABASE_URL=sqlite:///./astroia.db
JWT_SECRET=cambia-esta-clave
NASA_API_KEY=DEMO_KEY

# --- IA del chatbot ---
# Proveedor: auto | groq | gemini | local
#   auto  -> usa Groq si hay clave, si no Gemini, si no respuesta local
#   gemini -> fuerza Google AI Studio
AI_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Origenes separados por coma que pueden llamar a la API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
